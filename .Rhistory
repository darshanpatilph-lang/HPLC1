library(ggplot2)
# 1. Calibration data
cal <- data.frame(
Concentration = c(50, 75, 100, 125, 150),
Midostaurin = c(1298098, 1936557, 2648733, 3262068, 4105164),
Tretinoin   = c(2435341, 3658745, 4912724, 6108309, 7525413)
)
fit_mid <- lm(Midostaurin ~ Concentration, data = cal)
fit_tre <- lm(Tretinoin ~ Concentration, data = cal)
summary(fit_mid)
# 2. Validation sample peak areas
# Vials 1-3: 80%; 4-6: 100%; 7-9: 120%; 10-12: precision
validation <- data.frame(
Vial = 1:12,
Group = c(rep("80% accuracy", 3),
rep("100% accuracy", 3),
rep("120% accuracy", 3),
rep("Precision", 3)),
Nominal = c(rep(80, 3), rep(100, 3),
rep(120, 3), rep(100, 3)),
Mid_area = c(1452533, 1535012, 1592600,
1806537, 1911670, 1840053,
2513269, 2629371, 2654178,
1976272, 1905924, 1916131),
Tre_area = c(2513152, 2535819, 2668107,
3064524, 3365368, 2994015,
3391295, 3685673, 3820947,
2658344, 3783231, 3300577)
)
# 3. Calculate concentrations and apparent recovery
mid_coef <- coef(fit_mid)
tre_coef <- coef(fit_tre)
validation$Mid_conc <- (
validation$Mid_area - mid_coef[1]
) / mid_coef[2]
validation$Tre_conc <- (
validation$Tre_area - tre_coef[1]
) / tre_coef[2]
validation$Mid_recovery <- (
validation$Mid_conc / validation$Nominal
) * 100
validation$Tre_recovery <- (
validation$Tre_conc / validation$Nominal
) * 100
# Inspect vial-level results
print(validation, digits = 4)
View(validation)
# 4. Summary statistics function
summarise_results <- function(data, concentration, recovery, area) {
data.frame(
n = nrow(data),
Mean_concentration = mean(data[[concentration]]),
SD_concentration = sd(data[[concentration]]),
Concentration_CV_percent =
100 * sd(data[[concentration]]) /
mean(data[[concentration]]),
Mean_recovery_percent = mean(data[[recovery]]),
SD_recovery_percent = sd(data[[recovery]]),
Recovery_CV_percent =
100 * sd(data[[recovery]]) /
mean(data[[recovery]]),
Mean_area = mean(data[[area]]),
SD_area = sd(data[[area]]),
Area_CV_percent =
100 * sd(data[[area]]) / mean(data[[area]])
)
}
# Accuracy tables
accuracy_mid <- do.call(rbind, lapply(
c("80% accuracy", "100% accuracy", "120% accuracy"),
function(g) {
out <- summarise_results(
subset(validation, Group == g),
"Mid_conc", "Mid_recovery", "Mid_area"
)
out$Group <- g
out$Drug <- "Midostaurin"
out
}
))
accuracy_tre <- do.call(rbind, lapply(
c("80% accuracy", "100% accuracy", "120% accuracy"),
function(g) {
out <- summarise_results(
subset(validation, Group == g),
"Tre_conc", "Tre_recovery", "Tre_area"
)
out$Group <- g
out$Drug <- "Tretinoin"
out
}
))
accuracy_table <- rbind(accuracy_mid, accuracy_tre)
print(accuracy_table, digits = 4)
# Precision summary: three independent preparations
precision <- subset(validation, Group == "Precision")
precision_mid <- summarise_results(
precision, "Mid_conc", "Mid_recovery", "Mid_area"
)
precision_tre <- summarise_results(
precision, "Tre_conc", "Tre_recovery", "Tre_area"
)
precision_table <- rbind(
cbind(Drug = "Midostaurin", precision_mid),
cbind(Drug = "Tretinoin", precision_tre)
)
print(precision_table, digits = 4)
# 5. Figure 1: Apparent recovery by accuracy level
accuracy_plot_data <- rbind(
data.frame(
Drug = "Midostaurin",
Level = factor(c("80%", "100%", "120%"),
levels = c("80%", "100%", "120%")),
Mean = accuracy_mid$Mean_recovery_percent,
SD = accuracy_mid$SD_recovery_percent
),
data.frame(
Drug = "Tretinoin",
Level = factor(c("80%", "100%", "120%"),
levels = c("80%", "100%", "120%")),
Mean = accuracy_tre$Mean_recovery_percent,
SD = accuracy_tre$SD_recovery_percent
)
)
fig1 <- ggplot(
accuracy_plot_data,
aes(x = Level, y = Mean, group = Drug, shape = Drug)
) +
geom_point(size = 3, position = position_dodge(width = 0.25)) +
geom_errorbar(
aes(ymin = Mean - SD, ymax = Mean + SD),
width = 0.12,
position = position_dodge(width = 0.25)
) +
geom_hline(yintercept = 100, linetype = "dashed") +
labs(
title = "Apparent recovery at three concentration levels",
x = "Nominal accuracy level",
y = "Apparent recovery (%)",
shape = "Analyte"
) +
theme_classic(base_size = 12)
print(fig1)
ggsave("Figure1_Accuracy_Recovery.png", fig1,
width = 7, height = 5, dpi = 300)
# 6. Figure 2: Precision replicate peak areas
precision_long <- rbind(
data.frame(
Vial = precision$Vial,
Drug = "Midostaurin",
Peak_area = precision$Mid_area
),
data.frame(
Vial = precision$Vial,
Drug = "Tretinoin",
Peak_area = precision$Tre_area
)
)
fig2 <- ggplot(
precision_long,
aes(x = factor(Vial), y = Peak_area, shape = Drug)
) +
geom_point(size = 3) +
facet_wrap(~ Drug, scales = "free_y") +
labs(
title = "Peak-area variability in precision preparations",
x = "Vial number",
y = "Peak area"
) +
theme_classic(base_size = 12) +
theme(legend.position = "none")
print(fig2)
ggsave("Figure2_Precision_PeakAreas.png", fig2,
width = 7, height = 5, dpi = 300)
# 7. Export calculated results for the manuscript
write.csv(validation, "Accuracy_Precision_Vial_Results.csv",
row.names = FALSE)
write.csv(accuracy_table, "Accuracy_Summary_Table.csv",
row.names = FALSE)
write.csv(precision_table, "Precision_Summary_Table.csv",
row.names = FALSE)
