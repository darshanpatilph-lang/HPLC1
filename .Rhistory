library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
# Fit linear models for the 2–7 µg/mL range
mid_model <- lm(Mid_area ~ Concentration, data = low_conc)
names(low_conc)
head(low_conc)
library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
# Fit separate linear models for the low-concentration range
mid_model <- lm(
`Midostaurin — Peak area` ~ `Nominal concentration (µg/mL)`,
data = low_conc
)
tre_model <- lm(
`Tretinoin — Peak area` ~ `Nominal concentration (µg/mL)`,
data = low_conc
)
# Prepare diagnostic data
mid_diag <- data.frame(
Concentration = low_conc$`Nominal concentration (µg/mL)`,
Fitted = fitted(mid_model),
Residual = residuals(mid_model),
Analyte = "Midostaurin"
)
tre_diag <- data.frame(
Concentration = low_conc$`Nominal concentration (µg/mL)`,
Fitted = fitted(tre_model),
Residual = residuals(tre_model),
Analyte = "Tretinoin"
)
diag_data <- bind_rows(mid_diag, tre_diag)
# Plot 1: Residuals vs fitted values
p1 <- ggplot(diag_data, aes(Fitted, Residual)) +
geom_point(size = 2.5) +
geom_hline(yintercept = 0, linetype = "dashed") +
facet_wrap(~Analyte, scales = "free") +
labs(
title = "Residuals vs fitted response",
x = "Fitted peak area",
y = "Residual peak area"
) +
theme_bw()
# Plot 2: Residuals vs concentration
p2 <- ggplot(diag_data, aes(Concentration, Residual)) +
geom_point(size = 2.5) +
geom_hline(yintercept = 0, linetype = "dashed") +
facet_wrap(~Analyte, scales = "free") +
labs(
title = "Residuals vs concentration",
x = "Concentration (µg/mL)",
y = "Residual peak area"
) +
theme_bw()
# Plot 3: Normal Q-Q plots
p3 <- ggplot(diag_data, aes(sample = Residual)) +
stat_qq() +
stat_qq_line() +
facet_wrap(~Analyte, scales = "free") +
labs(title = "Normal Q-Q plots") +
theme_bw()
# Display plots
p1 / p2 / p3
summary(mid_model)
summary(tre_model)
